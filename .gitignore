# ── macOS ───────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.rustdesk_*

# ── iOS / Xcode / Swift ─────────────────────────────────
# The Xcode project is GENERATED from ios-app/project.yml via XcodeGen (see ADR-005).
ios-app/*.xcodeproj/
ios-app/*.xcworkspace/
ios-app/build/
ios-app/DerivedData/
**/xcuserdata/
**/*.xcuserstate
.swiftpm/
# `swift build` writes .build/ next to the Package.swift it is run from, so cover the
# FlintCore package too — not just ios-app/.
ios-app/**/.build/
*.ipa
*.dSYM.zip
*.dSYM
# Per-developer Xcode build settings (DEVELOPMENT_TEAM). Base.xcconfig includes it when present.
ios-app/Config/Local.xcconfig

# ── Android / Gradle / Kotlin ───────────────────────────
android-app/.gradle/
android-app/build/
android-app/**/build/
android-app/local.properties
android-app/captures/
*.iml
.idea/
.kotlin/
android-app/.cxx/
*.apk
*.aab
# Reference-app archives are local research inputs, not Flint source or release assets.
*.apkm
*.keystore
!debug.keystore
# Play upload signing: the keystore plus the passwords Gradle reads at build time.
# Created by scripts/setup-android-upload-key.sh. Never commit either file.
android-app/keystore.properties
*.jks
# App Store Connect API keys (.p8) and Play service-account JSON for CI uploads.
*.p8
play-service-account*.json

# ── Editors / misc ──────────────────────────────────────
.vscode/
*.log
.env
.env.local
__pycache__/
*.py[cod]

# ── Harness / session scratch (Claude worktrees, etc.) ──
# Ignore Claude's per-session scratch, but track project-level skills (shared with
# Codex through .agents/skills/, installed by `orca skills install --local`).
.claude/*
!.claude/skills/
!.claude/settings.json
.codex/*
!.codex/hooks.json

# ── Fleet coordination ledger (atomic claims; lives in the main checkout) ──
.flint-fleet/
