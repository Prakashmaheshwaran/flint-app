{
  "name": "Flint — Ember & Mist",
  "description": "Single source of truth for Flint's brand + UI tokens. Consumed manually by ios-app (FlintBrand / FlintUI in SwiftUI) and android-app (FlintTheme / FlintKit in Compose). Keep platform themes in sync with this file. Reference screens: design/ember-mist/*.dc.html.",
  "theme": "dark-only — one night palette for every screen on both platforms",
  "palette": {
    "night":  { "hex": "#0C0E13", "note": "sky top, block screen, full-bleed scenes" },
    "ground": { "hex": "#0E0D0F", "note": "app background for list screens" },
    "sheet":  { "hex": "#151417", "note": "sheets, dialogs" },
    "ridge":  { "hex": "#2C2522", "note": "far mountains" },
    "dusk":   { "hex": "#4B3322", "note": "horizon glow" },
    "bone":   { "hex": "#EDE6DA", "note": "primary text, light button" },
    "mist":   { "hex": "#B7AE9F", "note": "secondary text" },
    "stone":  { "hex": "#9C9486", "note": "tertiary text, inactive tabs" },
    "ember":  { "hex": "#EF9F27", "note": "THE one accent" },
    "glow":   { "hex": "#FFE7C2", "note": "orb core" },
    "flame":  { "hex": "#F7BE6A", "note": "orb mid / breath rings" },
    "spark":  { "hex": "#FAC775", "note": "logo spark highlight" },
    "emberTop": { "hex": "#F6B860", "note": "ember button gradient top" },
    "onEmber":  { "hex": "#3A2003", "note": "text/icon on ember" },
    "onBone":   { "hex": "#141316", "note": "text on bone button" },
    "knob":     { "hex": "#FFF6E8", "note": "switch knob when on" },
    "faint":    { "hex": "#8F887C", "note": "disabled text, placeholders" },
    "softBone": { "hex": "#D8CFC0", "note": "serif taglines, quiet emphasis" },
    "segment":  { "hex": "#2A2826", "note": "selected segment fill" },
    "danger":   { "hex": "#E58A7C", "note": "destructive text (delete)" }
  },
  "alpha": {
    "note": "bone (#EDE6DA) at these opacities draws every line and quiet surface",
    "hairline": 0.08,
    "divider": 0.10,
    "border": 0.16,
    "borderStrong": 0.18,
    "fillFaint": 0.03,
    "fill": 0.06,
    "segmentTrack": 0.05,
    "switchOff": 0.14,
    "emberWash": 0.12,
    "emberChip": 0.14,
    "emberBorder": 0.70,
    "tabBar": "rgba(24,22,24,0.82) + 18px blur, 1px bone@0.10 border"
  },
  "radius": { "tile": 10, "card": 20, "cardLarge": 24, "sheet": 32, "segment": 18, "segmentInner": 14, "pill": 999 },
  "spacing": { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32, "gutter": 24, "gutterEditor": 20, "tabBarInset": 24, "tabBarBottom": 28 },
  "size": { "buttonPrimary": 56, "buttonSecondary": 52, "ghost": 44, "chip": 40, "tabBar": 64, "switchW": 52, "switchH": 32, "row": 58, "touchMin": 44 },
  "typography": {
    "display": { "family": "Shippori Mincho", "weight": 400, "file": "ShipporiMincho-Regular.ttf" },
    "text":    { "family": "Hanken Grotesk", "weights": [400, 500, 600], "files": ["HankenGrotesk-Regular.ttf", "HankenGrotesk-Medium.ttf", "HankenGrotesk-SemiBold.ttf"] },
    "timer":     { "family": "display", "size": "62–84", "letterSpacing": -2.0 },
    "title":     { "family": "display", "size": "26–34", "letterSpacing": -0.3 },
    "number":    { "family": "display", "size": "22–52" },
    "button":    { "family": "text", "size": 16, "weight": 600 },
    "rowTitle":  { "family": "text", "size": 15, "weight": 500 },
    "body":      { "family": "text", "size": 15, "weight": 400 },
    "secondary": { "family": "text", "size": 13, "weight": 400, "color": "mist" },
    "eyebrow":   { "family": "text", "size": 11, "weight": 500, "letterSpacing": 2.0, "uppercase": true, "color": "mist" },
    "tab":       { "family": "text", "size": 11, "weight": "500 / 600 selected" },
    "numerals":  { "note": "tabular figures always — both bundled fonts have fixed-width digits" }
  },
  "motion": {
    "durationShortMs": 150,
    "durationMediumMs": 300,
    "durationLongMs": 450,
    "easingEmphasized": [0.2, 0, 0, 1],
    "easingStandard": [0.4, 0, 0.2, 1],
    "glowCycleMs": 8000,
    "breathCycleMs": 8000,
    "mistDriftMs": 22000,
    "note": "glow, breath and mist drift all stop under reduced motion"
  }
}
